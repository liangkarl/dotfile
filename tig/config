#
# The config is focused on the TUI based git tool,
# not full functional support of git.
#
# Config reference
# https://github.com/jonas/tig/blob/master/tigrc
# https://jonas.github.io/tig/doc/tigrc.5.html

# used for boosting loading speed
set main-options = -n 20000
set diff-options = --patience
set log-options  = --patience

set commit-order = default
set main-view-commit-title-graph = v1
set refresh-mode = after-command

# Addjust the column width of author
set main-view = date:custom,format="%m/%d/%y %H:%M" date:relative-compact \
                author:full,width=15 id:yes \
                commit-title:yes,graph,refs,overflow=no
set reflog-view = date:custom,format="%m/%d/%y %H:%M" date:relative-compact \
                  author:full,width=15 id:yes,color \
                  commit-title:yes,refs,overflow=no
set stash-view = date:custom,format="%m/%d/%y %H:%M" date:relative-compact \
                 author:full,width=15 id:yes,color \
                 commit-title:yes,refs,overflow=no
set refs-view = date:custom,format="%m/%d/%y %H:%M" date:relative-compact \
                ref id:yes,color \
                commit-title:yes,refs,overflow=no

set tree-view = date:custom,format="%m/%d/%y %H:%M" date:relative-compact \
                author:full,width=15 id:yes,color \
                mode file-size file-name
set blame-view = date:custom,format="%m/%d" date:relative-compact \
                 author:abbreviated,width=10 id:yes,color \
                 line-number:yes,interval=1 text

# Unbind keys {
bind generic f none
bind generic g none
bind generic y none
bind generic r none
bind generic l none
bind generic L none
bind generic d none
bind generic m none
bind generic s none
bind generic S none
bind generic , none
bind generic p none
bind generic q none
bind generic b none
bind generic o none
bind generic t none
bind generic <Ctrl-C> none
bind generic - none
bind generic R none
# }

# Views {
## Functional
bind generic 0  view-main
bind generic 9  view-reflog
bind generic 8  view-log
bind generic 1  view-status
bind generic 2  view-refs
bind generic 3  view-stash
bind generic T  view-tree
bind generic -g view-grep
bind generic B  view-blame

bind stage   1  none
bind stage   2  none

# 0 -> 1 -> 2 -> 3 -> 8 -> 9 -> 0
# main -> status -> refs -> stash -> log -> reflog -> main
# ',': previous (left)
# '.': next (right)
bind main   . view-status
bind status . view-refs
bind stage  . view-refs
bind diff   . view-refs
bind refs   . view-stash
bind stash  . view-log
bind log    . view-reflog
bind reflog . view-main

bind main   , view-reflog
bind reflog , view-log
bind log    , view-stash
bind stash  , view-refs
bind refs   , view-status
bind status , view-main
bind stage  , view-main
bind diff   , view-main

# tree -> blob -> blame
bind tree   . view-blob
bind blob   . view-blame
bind blame  . view-tree

bind tree   , view-blame
bind blame  , view-blob
bind blob   , view-tree

## Force refresh view
bind main   = <tig
bind status = <tig status
bind refs   = <tig refs
bind stash  = <tig stash
bind log    = <tig log
bind reflog = <tig reflog
bind blame  = <tig blame %(file)
bind diff   = <tig show %(commit)
bind stage  = <tig

## Blame format
bind blame -<ENTER> :set blame-options += -w -C -C -C

## Diff format
bind diff  -<ENTER> :set diff-options += --patience --ignore-all-space --ignore-blank-lines --ignore-cr-at-eol --ignore-space-at-eol --ignore-space-change
bind diff  -r       :set diff-options = --patience

## Stage format
bind stage -<ENTER> :set diff-options += --patience --ignore-all-space --ignore-blank-lines --ignore-cr-at-eol --ignore-space-at-eol --ignore-space-change
bind stage -r       :set diff-options = --patience

## Main format
bind main  -<ENTER> :set main-options += --no-merges
bind main  -A       :set main-options += --no-merges --author="%(prompt search author name: )"
bind main  -a       :set main-options += --no-merges --author="%(author)"

## Refs format
bind refs  -b       <tig refs --branches
bind refs  -t       <tig refs --tags
bind refs  -r       <tig refs --remotes

## tree/blob/blame -> main %(file)
bind blob  -f       >tig --no-merges %(commit) -- %(file)
bind tree  -f       >tig --no-merges %(commit) -- %(file)
bind blame -f       >tig --no-merges %(commit) -- %(file)
bind stage -f       >tig --no-merges %(commit) -- %(file)
bind diff  -f       >tig --no-merges %(commit) -- %(file)

# Log format
bind log   -<ENTER> :set log-options += --patience -p --no-merges --ignore-all-space --ignore-blank-lines --ignore-cr-at-eol --ignore-space-at-eol --ignore-space-change
bind log   -r       :set log-options = --patience
bind log   -v       :set log-options += -p
bind log   -s       :set log-options += --stat
bind log   -A       :set log-options += --no-merges --author="%(prompt search author name: )"
bind log   -a       :set log-options += --no-merges --author="%(author)"
bind log   -f       :set log-options += -- "%(file)"

## Options
bind generic os :toggle sort-field
bind generic od :toggle date
bind generic oa :toggle author
bind generic oi :toggle id
bind generic og :toggle graph
bind generic of :toggle file-name
bind generic oF :toggle file-filter
bind generic op :toggle ignore-space
bind generic or :toggle commit-title-refs
# }

# Misc {
## Move light bar to top/button
bind generic gg move-first-line
bind generic G  move-last-line
bind main    G  move-last-line

bind generic H  view-help
bind main    H  view-help
bind generic l  scroll-right
bind generic h  scroll-left
bind generic q  view-close-no-quit
bind generic J  next
bind generic K  previous
bind generic <Up> move-up
bind generic <Down> move-down
bind generic Q  quit
bind generic <Ctrl-r> <tig

bind generic ;  +git rev-parse --show-toplevel

bind generic yy +git cmd copy TEXT='%(commit)'
bind generic yf +git cmd copy TEXT='%(file)'
bind generic yF +git cmd copy TEXT='%(file_old)'
bind generic yb +git cmd copy TEXT='%(branch)'
bind generic yt +git cmd copy TEXT='%(tag)'
# }


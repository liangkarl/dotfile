# Feature {
## Commit
bind generic c        none
bind main    c<ENTER>  >git commit -v
bind main    ca       >?git commit -v --amend
bind main    cn       @?git commit --amend --no-edit
bind stage   c<ENTER>  >git commit -v
bind stage   ca       >?git commit -v --amend
bind stage   cn       @?git commit --amend --no-edit
bind status  c<ENTER>  >git commit -v
bind status  ca       >?git commit -v --amend
bind status  cn       @?git commit --amend --no-edit

## Stage/Unstage file
bind stage   f<Enter> @git cmd stage.file FILE='%(file)'
bind stage   fa       @git cmd stage.file

## Add stash
bind main    s<Enter>  @git cmd stash.save
bind main    sp       :!git cmd stash.pop
bind stage   s<Enter>  @git cmd stash.save
bind stage   sp       :!git cmd stash.pop
bind status  s<Enter>  @git cmd stash.save
bind status  sp       :!git cmd stash.pop

## Add/Remove/Move tag and branch
bind main   rn       @git  cmd refs.rename C=%(commit)
bind main   a<ENTER> :!git cmd refs.add C=%(commit)
bind main   d<ENTER> :!git cmd refs.cut C=%(commit)
bind reflog rn       @git  cmd refs.rename C=%(commit)
bind reflog a<ENTER> :!git cmd refs.add C=%(commit)
bind reflog d<ENTER> :!git cmd refs.cut C=%(commit)
bind diff   rn       @git  cmd refs.rename C=%(commit)
bind diff   a<ENTER> :!git cmd refs.add C=%(commit)
bind diff   d<ENTER> :!git cmd refs.cut C=%(commit)
bind refs   rn       @git  cmd refs.rename C=%(commit) REFS=%(refname)
bind refs   a<ENTER> :!git cmd refs.add C=%(commit)
bind refs   d<ENTER> :!git cmd refs.cut REFS=%(refname)
bind refs   d!       @?git cmd refs.cut TAG=%(tag) BR=%(branch) REMOTE=%(remote)

##   Checkout
bind main   co        :!git cmd git.auto checkout %(commit)
bind refs   co        :!git cmd git.auto checkout %(ref)
bind reflog co        :!git cmd git.auto checkout %(commit)
bind status co        +?git cmd git.msg  checkout %(file)
bind stage  co        +?git cmd git.msg  checkout %(file)
bind stage  c<LT><LT> +?git cmd git.msg  checkout --ours   %(file)
bind stage  c>>       +?git cmd git.msg  checkout --theirs %(file)
bind diff   co        +?git cmd git.msg  checkout %(commit)  -- %(file)
bind diff   cO        +?git cmd git.msg  checkout %(commit)^ -- %(file)

### File Operation
bind main   dc       +?git cmd git.msg clean -fd
bind status dc       +?git cmd git.msg clean -fd
bind status d<ENTER> :!git cmd delete NAME=%(file)
bind stage  d<ENTER> :!git cmd delete NAME=%(file)
bind diff   d<ENTER> :!git cmd delete NAME=%(file)

## Reset commits
bind stage  r.       +?git cmd git.msg reset --hard
bind main   r.       +?git cmd git.msg reset --hard
bind stage  r,       +?git cmd git.msg reset
bind main   r,       +?git cmd git.msg reset
bind main   rp       +?git cmd git.msg reset --soft HEAD@{1}
bind reflog R<Enter> +?git cmd git.msg reset --hard %(commit)
bind diff   R<Enter> +?git cmd git.msg reset --hard %(commit)
bind main   R<Enter> +?git cmd git.msg reset --hard %(commit)
bind reflog r<Enter> +?git cmd git.msg reset --soft %(commit)
bind diff   r<Enter> +?git cmd git.msg reset --soft %(commit)
bind main   r<Enter> +?git cmd git.msg reset --soft %(commit)
bind main   rr       +?git cmd git.msg reset

## Cherry-pick
bind main   cp       :!git cmd git.auto cherry-pick -s %(commit)
bind main   cP       :!git cmd git.msg  cherry-pick -s %(commit)
bind main   cs       >git  cmd commit.create TYPE=select-patch
bind main   cS       >git  cmd commit.create TYPE=merge-pick
bind main   cc       >git  cmd commit.create TYPE=reuse-msg
bind reflog cp       :!git cmd git.auto cherry-pick -s %(commit)
bind reflog cP       :!git cmd git.msg  cherry-pick -s %(commit)
bind reflog cs       >git  cmd commit.create TYPE=merge-pick
bind reflog cc       >git  cmd commit.create TYPE=reuse-msg
bind diff   cp       :!git cmd git.auto cherry-pick -s %(commit)
bind diff   cP       :!git cmd git.msg  cherry-pick -s %(commit)

## Format patch
bind main   p<Enter> :!git cmd patch.create C=%(commit)
bind diff   p<Enter> :!git cmd patch.create TYPE=commit C=%(commit)
bind log    p<Enter> :!git cmd patch.create TYPE=commit C=%(commit)
bind reflog p<Enter> :!git cmd patch.create TYPE=commit C=%(commit)
bind stage  p<Enter> :!git cmd patch.create C=%(commit)
bind stash  p<Enter> :!git cmd patch.create TYPE=stash C=%(stash)

# Save Info
bind refs   ss       :!git cmd info.write   C=%(commit) BR=%(branch) REF=%(refname) TAG=%(tag) FILE=%(file) OFILE=%(file_old)
bind main   ss       :!git cmd info.write   C=%(commit) FILE=%(file) OFILE=%(file_old)
bind reflog ss       :!git cmd info.write   C=%(commit) FILE=%(file) OFILE=%(file_old)
bind reflog sc       @git cmd select.add C=%(commit)
bind log    sc       @git cmd select.add C=%(commit)
bind diff   sc       @git cmd select.add C=%(commit)
bind main   sc       !git cmd select.add C=%(commit)
bind main   sr       !git  cmd select.reset
bind diff   sr       @git  cmd select.reset
bind reflog sr       @git  cmd select.reset


# Check line history {
bind stage b       :!git cmd info.line_history LINE=%(lineno) FILE=%(file)
bind diff  b       :!git cmd info.line_history LINE=%(lineno) FILE=%(file) REV=%(commit)
bind blame b       :!git cmd info.line_history LINE=%(lineno) FILE=%(file) REV=%(commit)
# }

# Stage {
bind stage A stage-update-part
bind stage a stage-update-line
# }

# Status {
bind status C none
bind status ! none
# }

# Reference {
bind refs C none
bind refs ! none

bind refs f<ENTER> :!git cmd git.msg fetch --prune --all
bind refs rb       :!git cmd git.auto rebase %(commit)
bind refs rB       :!git cmd git.msg rebase %(commit)
# 1. Select local branch
# 2. Select assigned remote branch
bind refs pb       !?git cmd refs.push BR="%(prompt new branch: )" REMOTE=%(remote)
bind refs pt       !?git cmd refs.push TAG="%(prompt new tag: )" REMOTE=%(remote)
bind refs pc       !?git cmd refs.push REMOTE=%(remote)
bind refs pp       !?git cmd refs.push TAG=%(tag) BR=%(branch) REF=%(refname)
bind refs pP       !?git cmd refs.push TAG=%(tag) BR=%(branch) REF=%(refname) OPT='--force-with-lease'
bind refs pu       !?git cmd refs.push TAG=%(tag) BR=%(branch) UPSTREAM=%(repo:upstream)
bind refs cs        +git cmd info.clean
bind refs >         >tig %(commit)
# }

# Main {
bind main C none
bind main ! none

bind main bs +?git cmd git.msg bisect start
bind main bg +?git cmd git.msg bisect good %(commit)
bind main bb +?git cmd git.msg bisect bad %(commit)
bind main br +?git cmd git.msg bisect reset
bind main rv :!git cmd git.auto revert --no-edit %(commit)
bind main rV :!git cmd git.msg revert --no-edit %(commit)
bind diff rv :!git cmd git.auto revert --no-edit %(commit)
bind diff rV :!git cmd git.msg revert --no-edit %(commit)
bind main rb >?git cmd git.auto rebase -i %(commit)
bind main rB >?git cmd git.msg rebase -i %(commit)
bind main rk >?git rebase --skip
# progress stop: rebase, merge, revert, cherry-pick
bind main pa :!git cmd action.abort
# progress continue: rebase, merge, revert, cherry-pick
bind main pc :!git cmd action.next
# progress info
bind main pi :!git cmd action.check
bind main <SingleQuote> :!git cmd commit_report
# }

# Log {
# }

# Reflog {
bind reflog C none
bind reflog ! none
# }

# Pager {
bind pager <Space> view-close-no-quit

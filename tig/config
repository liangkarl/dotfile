# Feature {
## Commit
bind generic c        none
bind main    c<ENTER>  >git commit -v
bind main    ca       >?git commit -v --amend
bind main    cn       @?git commit --amend --no-edit
bind stage   c<ENTER>  >git commit -v
bind stage   ca       >?git commit -v --amend
bind stage   cn       @?git commit --amend --no-edit
bind status  c<ENTER>  >git commit -v
bind status  ca       >?git commit -v --amend
bind status  cn       @?git commit --amend --no-edit

## Stage/Unstage file
bind stage   f<Enter> @git ui stage.file FILE='%(file)'
bind stage   fa       @git ui stage.file

## Add stash
bind main    sa        @git ui stash.save NAME="%(prompt new stash: )"
bind main    s<Enter>  @git ui stash.save
bind main    sp       :!git ui stash.pop
bind stage   sa        @git ui stash.save NAME="%(prompt new stash: )"
bind stage   s<Enter>  @git ui stash.save
bind stage   sp       :!git ui stash.pop
bind status  sa        @git ui stash.save NAME="%(prompt new stash: )"
bind status  s<Enter>  @git ui stash.save
bind status  sp       :!git ui stash.pop

## Add/Remove/Move tag and branch
bind main   ta       @git ui git.msg tag "%(prompt new tag: )" %(commit)
bind main   tr       @git ui refs.rename C=%(commit) NAME="%(prompt rename tag: )" TAG=%(tag)
bind main   t<ENTER> @git ui git.msg tag tag.$(git rev-parse --short %(commit)) %(commit)
bind main   ba       @git ui git.msg branch "%(prompt new branch: )" %(commit)
bind main   br       @git ui refs.rename C=%(commit) NAME="%(prompt rename branch: )" BR=%(branch)
bind main   b<ENTER> @git ui git.msg branch $(basename $(git rev-parse --show-toplevel)) %(commit)
bind main   a<ENTER> @git ui refs.paste C=%(commit)
bind main   d<ENTER> @git ui refs.cut C=%(commit)
bind main   bd       @git ui refs.cut C=%(commit) BR=%(branch)
bind main   td       @git ui refs.cut C=%(commit) TAG=%(tag)
bind reflog ta       @git ui git.msg tag "%(prompt new tag: )" %(commit)
bind reflog tr       @git ui refs.rename C=%(commit) NAME="%(prompt rename tag: )" TAG=%(tag)
bind reflog t<ENTER> @git ui git.msg tag tag.$(git rev-parse --short %(commit)) %(commit)
bind reflog ba       @git ui git.msg branch "%(prompt new branch: )" %(commit)
bind reflog br       @git ui refs.rename C=%(commit) NAME="%(prompt rename branch: )" BR=%(branch)
bind reflog b<ENTER> @git ui git.msg branch $(basename $(git rev-parse --show-toplevel)) %(commit)
bind reflog a<ENTER> @git ui refs.paste C=%(commit)
bind reflog d<ENTER> @git ui refs.cut C=%(commit)
bind reflog bd       @git ui refs.cut C=%(commit) BR=%(branch)
bind reflog td       @git ui refs.cut C=%(commit) TAG=%(tag)
bind diff   ta       @git ui git.msg tag "%(prompt new tag: )" %(commit)
bind diff   tr       @git ui refs.rename C=%(commit) NAME="%(prompt rename tag: )" TAG=%(tag)
bind diff   t<ENTER> @git ui git.msg tag tag.$(git rev-parse --short %(commit)) %(commit)
bind diff   ba       @git ui git.msg branch "%(prompt new branch: )" %(commit)
bind diff   br       @git ui refs.rename C=%(commit) NAME="%(prompt rename branch: )" BR=%(branch)
bind diff   b<ENTER> @git ui git.msg branch $(basename $(git rev-parse --show-toplevel)) %(commit)
bind diff   a<ENTER> @git ui refs.paste C=%(commit)
bind diff   d<ENTER> @git ui refs.cut C=%(commit)
bind refs   ta       @git ui git.msg tag "%(prompt new tag: )" HEAD
bind refs   tr       @git ui refs.rename C=%(commit) NAME="%(prompt rename tag: )" TAG=%(tag)
bind refs   t<ENTER> @git ui git.msg tag tag.$(git rev-parse --short HEAD) HEAD
bind refs   ba       @git ui git.msg branch "%(prompt new branch: )" HEAD
bind refs   br       @git ui refs.rename C=%(commit) NAME="%(prompt rename branch: )" BR=%(branch)
bind refs   b<ENTER> @git ui git.msg branch $(basename $(git rev-parse --show-toplevel)) HEAD
bind refs   a<ENTER> @git ui refs.paste C=%(commit)
bind refs   d<ENTER> @git ui refs.cut C=%(commit) BR=%(branch) TAG=%(tag)
bind refs   d!!      !?git ui refs.cut TAG=%(TAG) BR=%(branch) REMOTE=%(remote)

## Checkout
bind main   co :!git ui git.auto checkout %(commit)
bind refs   co :!git ui git.auto checkout %(ref)
bind reflog co :!git ui git.auto checkout %(commit)
bind status co +?git ui git.msg  checkout %(file)
bind stage  co +?git ui git.msg  checkout %(file)
bind stage  c<LT><LT> +?git ui git.msg checkout --ours %(file)
bind stage  c>> +?git ui git.msg checkout --theirs %(file)
bind diff   co +?git ui git.msg checkout %(commit) -- %(file)
bind diff   cO +?git ui git.msg checkout %(commit)^ -- %(file)

### File Operation
bind main   dc       +?git ui git.msg clean -fd
bind status d<Enter> +?git ui cmd rm -rf %(file)
bind status dd       +?git ui cmd rm -rf $(dirname %(file))
bind status dc       +?git ui git.msg clean -fd
bind stage  d<Enter> +?git ui cmd rm -rf %(file)
bind stage  dd       +?git ui cmd rm -rf $(dirname %(file))
bind stage  dc       +?git ui git.msg clean -fd
bind diff   d<Enter> +?git ui cmd rm -rf %(file)
bind diff   dd       +?git ui cmd rm -rf $(dirname %(file))

## Reset commits
bind stage   rS +?git ui git.msg reset --hard
bind reflog  rS +?git ui git.msg reset --hard %(commit)
bind diff    rS +?git ui git.msg reset --hard %(commit)
bind main    rS +?git ui git.msg reset --hard %(commit)
bind reflog  rs +?git ui git.msg reset %(commit)
bind diff    rs +?git ui git.msg reset %(commit)
bind main    rs +?git ui git.msg reset %(commit)
bind main    rn +?git ui git.msg reset --hard
bind main    rp +?git ui git.msg reset HEAD@{1}

## Cherry-pick
bind main   cp :!git ui git.auto cherry-pick -s %(commit)
bind refs   cp :!git ui git.auto cherry-pick -s %(commit)
bind reflog cp :!git ui git.auto cherry-pick -s %(commit)
bind diff   cp :!git ui git.auto cherry-pick -s %(commit)

## Format patch {
bind main   pr       @git ui patch.reset
bind main   ps       :!git ui patch.add C=%(commit)
bind main   p<Enter> :!git ui patch.create
bind main   pn       :!git ui patch.create C=%(commit)^
bind main   p1       :!git ui patch.create C=%(commit) NAME='$(date +%y%m%d%H%M%S)'
bind diff   ps       @git ui patch.add C=%(commit)
bind diff   pr       @git ui patch.reset
bind diff   p<Enter> :!git ui patch.create
bind diff   p1       :!git ui patch.create C=%(commit)
bind diff   pn       :!git ui patch.create C=%(commit)^
bind diff   pf       :!git ui patch.create C=%(commit) FILE=%(file)
bind log    ps       @git ui patch.add C=%(commit)
bind log    pr       @git ui patch.reset
bind log    p<Enter> :!git ui patch.create
bind log    p1       :!git ui patch.create C=%(commit)
bind log    pn       :!git ui patch.create C=%(commit)^
bind log    pf       :!git ui patch.create C=%(commit) FILE=%(file)
bind reflog ps       @git ui patch.add C=%(commit)
bind reflog pr       @git ui patch.reset
bind reflog p<Enter> +git ui patch.create
bind reflog p1       :!git ui patch.create C=%(commit)
bind blame  p1       :!git ui patch.create C=%(commit)
bind stage  p1       :!git ui patch.create C=%(commit) NAME='$(date +%y%m%d%H%M%S)'
bind stage  pf       :!git ui patch.create C=%(commit) NAME='$(date +%y%m%d%H%M%S)_$(basename %(file))' FILE=%(file)
# }

# Save Info {
bind refs ss       :!git ui info.write C=%(commit) BR=%(branch) REF=%(refname) TAG=%(tag) FILE=%(file) OFILE=%(file_old)
bind main ss       :!git ui info.write C=%(commit) FILE=%(file) OFILE=%(file_old)
bind reflog ss     :!git ui info.write C=%(commit) FILE=%(file) OFILE=%(file_old)
# }

# Check line history {
bind stage b       :!git ui info.line_history LINE=%(lineno) FILE=%(file)
bind diff  b       :!git ui info.line_history LINE=%(lineno) FILE=%(file) REV=%(commit)
bind blame b       :!git ui info.line_history LINE=%(lineno) FILE=%(file) REV=%(commit)
# }

# Stage {
bind stage A stage-update-part
bind stage a stage-update-line
# }

# Status {
bind status C none
bind status ! none
# }

# Reference {
bind refs C none
bind refs ! none

bind refs f<ENTER> :!git ui git.msg fetch --prune --all
bind refs rb       :!git ui git.auto rebase %(commit)
# 1. Select local branch
# 2. Select assigned remote branch
bind refs pb       !?git ui refs.push BR="%(prompt new branch: )" REMOTE=%(remote)
bind refs pt       !?git ui refs.push TAG="%(prompt new tag: )" REMOTE=%(remote)
bind refs pc       !?git ui refs.push REMOTE=%(remote)
bind refs pp       !?git ui refs.push TAG=%(tag) BR=%(branch) REF=%(refname)
bind refs pP       !?git ui refs.push TAG=%(tag) BR=%(branch) REF=%(refname) OPT='--force-with-lease'
bind refs cs        +git ui info.clean
# }

# Main {
bind main C none
bind main ! none

bind main bs +?git ui git.msg bisect start
bind main bg +?git ui git.msg bisect good %(commit)
bind main bb +?git ui git.msg bisect bad %(commit)
bind main rv :!git ui git.auto revert --no-edit %(commit)
bind diff rv :!git ui git.auto revert --no-edit %(commit)
bind main rb >?git ui git.auto rebase -i %(commit)
bind main rk >?git rebase --skip
# progress stop: rebase, merge, revert, cherry-pick, bisect
bind main pa :!git ui act.abort
# progress continue: rebase, merge, revert, cherry-pick, bisect
bind main pc :!git ui act.going
# progress info
bind main pi  +git ui act.check
bind main pp !?git ui refs.push C=%(commit)
bind main pP !?git ui refs.push C=%(commit) OPT='--force-with-lease'
bind main <SingleQuote> :!git ui commit_report
# }

# Log {
# }

# Reflog {
bind reflog C none
bind reflog ! none
# }

# Pager {
bind pager <Space> view-close-no-quit

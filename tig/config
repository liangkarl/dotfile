# Feature {
## Commit
bind generic c        none
bind main    c<ENTER>  >git commit -v
bind main    ca       >?git commit -v --amend
bind main    cn       @?git commit --amend --no-edit
bind stage   c<ENTER>  >git commit -v
bind stage   ca       >?git commit -v --amend
bind stage   cn       @?git commit --amend --no-edit
bind status  c<ENTER>  >git commit -v
bind status  ca       >?git commit -v --amend
bind status  cn       @?git commit --amend --no-edit

## Stage/Unstage file
bind stage   f<Enter> @git ui stage.file FILE='%(file)'
bind stage   fa       @git ui stage.file

## Add stash
bind main    sa        @git ui stash.save NAME="%(prompt new stash: )"
bind main    s<Enter>  @git ui stash.save
bind main    sp       :!git ui stash.pop
bind stage   sa        @git ui stash.save NAME="%(prompt new stash: )"
bind stage   s<Enter>  @git ui stash.save
bind stage   sp       :!git ui stash.pop
bind status  sa        @git ui stash.save NAME="%(prompt new stash: )"
bind status  s<Enter>  @git ui stash.save
bind status  sp       :!git ui stash.pop

## Add/Remove/Move tag and branch
bind main   ta       @git ui git.msg tag "%(prompt new tag: )" %(commit)
bind main   t<ENTER> @git ui git.msg tag tag.$(git rev-parse --short %(commit)) %(commit)
bind main   ba       @git ui git.msg branch "%(prompt new branch: )" %(commit)
bind main   b<ENTER> @git ui git.msg branch branch.$(basename $(git rev-parse --show-toplevel)) %(commit)
bind main   a<ENTER> @git ui refs.paste C=%(commit)
bind main   d<ENTER> @git ui refs.cut C=%(commit)
bind main   db       @git ui refs.cut C=%(commit) BR=%(branch)
bind reflog ta       @git ui git.msg tag "%(prompt new tag: )" %(commit)
bind reflog t<ENTER> @git ui git.msg tag tag.$(git rev-parse --short %(commit)) %(commit)
bind reflog ba       @git ui git.msg branch "%(prompt new branch: )" %(commit)
bind reflog b<ENTER> @git ui git.msg branch branch.$(basename $(git rev-parse --show-toplevel)) %(commit)
bind reflog a<ENTER> @git ui refs.paste C=%(commit)
bind reflog d<ENTER> @git ui refs.cut C=%(commit)
bind reflog db       @git ui refs.cut C=%(commit) BR=%(branch)
bind diff   ta       @git ui git.msg tag "%(prompt new tag: )" %(commit)
bind diff   t<ENTER> @git ui git.msg tag tag.$(git rev-parse --short %(commit)) %(commit)
bind diff   ba       @git ui git.msg branch "%(prompt new branch: )" %(commit)
bind diff   b<ENTER> @git ui git.msg branch branch.$(basename $(git rev-parse --show-toplevel)) %(commit)
bind diff   a<ENTER> @git ui refs.paste C=%(commit)
bind diff   d<ENTER> @git ui refs.cut C=%(commit)
bind refs   ta       @git ui git.msg tag "%(prompt new tag: )" HEAD
bind refs   t<ENTER> @git ui git.msg tag tag.$(git rev-parse --short HEAD) HEAD
bind refs   ba       @git ui git.msg branch "%(prompt new branch: )" HEAD
bind refs   b<ENTER> @git ui git.msg branch branch.$(basename $(git rev-parse --show-toplevel)) HEAD
bind refs   a<ENTER> @git ui refs.paste C=%(commit)
bind refs   d<ENTER> @git ui refs.cut C=%(commit)

## Checkout
bind main   co  +git ui git.msg checkout %(commit)
bind refs   co  +git ui git.msg checkout %(ref)
bind reflog co  +git ui git.msg checkout %(commit)
bind status co +?git ui git.msg checkout %(file)
bind stage  co +?git ui git.msg checkout %(file)
bind stage  ct +?git ui git.msg checkout --theirs %(file)
bind stage  cu +?git ui git.msg checkout --ours %(file)
bind diff   co +?git ui git.msg checkout %(file)

### File Operation
bind main   dc       +?git ui git.msg clean -fd
bind status d<Enter> @?rm -rf %(file)
bind status dd       @?rm -rf $(dirname %(file))
bind status dc       +?git ui git.msg clean -fd
bind stage  d<Enter> @?rm -rf %(file)
bind stage  dd       @?rm -rf $(dirname %(file))
bind stage  dc       +?git ui git.msg clean -fd
bind diff   d<Enter> @?rm -rf %(file)
bind diff   dd       @?rm -rf $(dirname %(file))

## Reset commits
bind main    rh +sh -c '[[ "%(prompt enter "y" to hard reset: )" == "y" ]] && git reset --hard %(commit)'
bind reflog  rh +sh -c '[[ "%(prompt enter "y" to hard reset: )" == "y" ]] && git reset --hard %(commit)'
bind diff    rh +sh -c '[[ "%(prompt enter "y" to hard reset: )" == "y" ]] && git reset --hard %(commit)'
bind main    rs +sh -c '[[ "%(prompt enter "y" to reset: )" == "y" ]] && git reset %(commit)'
bind reflog  rs +sh -c '[[ "%(prompt enter "y" to reset: )" == "y" ]] && git reset %(commit)'
bind diff    rs +sh -c '[[ "%(prompt enter "y" to reset: )" == "y" ]] && git reset %(commit)'
bind stage   rn +sh -c '[[ "%(prompt enter "y" to hard reset HEAD: )" == "y" ]] && git reset --hard'
bind main    rn +sh -c '[[ "%(prompt enter "y" to hard reset HEAD: )" == "y" ]] && git reset --hard'
bind main    rp +sh -c '[[ "%(prompt enter "y" to reset HEAD@{1}: )" == "y" ]] && git reset HEAD@{1}'

## Cherry-pick
bind main   cp :!git ui git.auto cherry-pick -s %(commit)
bind refs   cp :!git ui git.auto cherry-pick -s %(commit)
bind reflog cp :!git ui git.auto cherry-pick -s %(commit)
bind diff   cp :!git ui git.auto cherry-pick -s %(commit)

## Format patch {
bind main   ps       @git ui patch.add C=%(commit)
bind main   p<Enter> +git ui patch.create
bind main   p1       +git ui git.msg format-patch -k --binary --histogram -o .patch -2 %(commit)
bind main   pn       +git ui git.msg format-patch -k --binary --histogram -o .patch %(commit)^
bind main   pr       +git ui patch.reset
bind diff   ps       @git ui patch.add C=%(commit)
bind diff   p<Enter> +git ui patch.create
bind diff   p1       +git ui git.msg format-patch -k --binary --histogram -o .patch -1 %(commit)
bind diff   pn       +git ui git.msg format-patch -k --binary --histogram -o .patch %(commit)^
bind diff   pf       +git ui git.msg format-patch -k --binary --histogram -o .patch %(commit) %(file)
bind diff   pr       @git ui patch.reset
bind log    ps       @git ui patch.add C=%(commit)
bind log    p<Enter> +git ui patch.create
bind log    p1       +git ui git.msg format-patch -k --binary --histogram -o .patch -1 %(commit)
bind log    pn       +git ui git.msg format-patch -k --binary --histogram -o .patch %(commit)^
bind log    pf       +git ui git.msg format-patch -k --binary --histogram -o .patch %(commit) %(file)
bind log    pr       @git ui patch.reset
bind reflog ps       @git ui patch.add C=%(commit)
bind reflog p<Enter> +git ui patch.create
bind reflog p1       +git ui git.msg format-patch -k --binary --histogram -o .patch -1 %(commit)
bind reflog pr       @git ui patch.reset
bind blame  p1       +git ui git.msg format-patch -k --binary --histogram -o .patch -1 %(commit)
bind stage  p1       @git ui git.msg diff --output=$(date +%y%m%d%H%M%S).diff --binary --histogram
bind stage  pf       @git ui git.msg diff --output=$(date +%y%m%d%H%M%S)_$(basename %(file)).diff --binary --histogram %(file)
# }


#!/usr/bin/env bash

source "$(bash-env)" || { return 1 2>/dev/null || exit 1; }

load devel

skip=
for i in $(find $1 -type f -name *.patch | sort); do
	echo "-- $i: --"
	if [[ -n "$skip" ]]; then
		echo "skip"
		continue
	fi
	if ! patch -p1 < $i; then
		msg.err "Failed: $i"
		skip=y
	fi
done

echo "-- done --"

#!/usr/bin/env bash

set -euo pipefail

usage() {
	cat <<EOF
NAME:
    $(basename "$0") - a small format tool for text-based files

SYNOPSIS:
    $(basename "$0") [-h] [-b SUFFIX] [-u] [-c] [-s] FILE...
    $(basename "$0") -p PATH-IN-WINDOWS...

OPTIONS:
    -h            Show help
    -b SUFFIX     Create backup with suffix, e.g. -b bak -> file.bak
    -u            Convert Windows line breaks to Unix
    -c            Trim ANSI color codes
    -s            Trim trailing spaces
    -p            Convert Windows path '\' into POSIX path '/'
EOF
}

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

is_gnu_sed() {
	sed --version >/dev/null 2>&1
}

run_sed_in_place() {
	local file=$1

	if is_gnu_sed; then
		sed -i"${backup_suffix}" "${sed_args[@]}" -- "$file"
	else
		sed -i "${backup_suffix}" "${sed_args[@]}" "$file"
	fi
}

replace_backslash() {
	local path
	for path in "$@"; do
		printf '%s\n' "${path//\\//}"
	done
}

backup_suffix=''
do_unix=0
do_color=0
do_space=0
do_path=0

while getopts ":hb:ucsp" opt; do
	case "$opt" in
		h)
			usage
			exit 0
			;;
		b)
			backup_suffix=".$OPTARG"
			;;
		u)
			do_unix=1
			;;
		c)
			do_color=1
			;;
		s)
			do_space=1
			;;
		p)
			do_path=1
			;;
		:)
			die "Option -$OPTARG requires an argument."
			;;
		\?)
			usage >&2
			exit 2
			;;
	esac
done

shift $((OPTIND - 1))

if (( do_path )); then
	(( do_unix || do_color || do_space )) && die "-p cannot be used with -u/-c/-s"
	(( $# > 0 )) || die "Missing PATH-IN-WINDOWS."
	replace_backslash "$@"
	exit 0
fi

(( do_unix || do_color || do_space )) || {
	usage >&2
	exit 1
}

(( $# > 0 )) || die "Missing FILE."

sed_args=()

if (( do_unix )); then
	sed_args+=(-e $'s/\r$//')
fi

if (( do_color )); then
	sed_args+=(-e $'s/\x1B\\[[0-9;]*m//g')
fi

if (( do_space )); then
	sed_args+=(-e 's/[[:space:]]*$//')
fi

for file in "$@"; do
	[[ -f "$file" ]] || die "Not a regular file: $file"
	run_sed_in_place "$file"
done

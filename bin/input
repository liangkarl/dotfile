#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
import tempfile


MENU_OPTIONS = {"list", "menu", "mru", "multi", "value"}
FILE_OPTIONS = {"load", "save"}
DISPLAY_OPTIONS = {"popup", "split"}
ALL_OPTIONS = MENU_OPTIONS | FILE_OPTIONS | DISPLAY_OPTIONS


def default_state():
    return {
        "title": "",
        "prompt": ">",
        "default": "",
        "index": 0,
        "items": [],
        "height": 10,
        "backend": "fzf",
        "layout": "popup",
        "delim": None,
        "options": []
    }


def selected_options(parser, option_groups):
    options = set()
    for option_group in option_groups or []:
        for option in option_group.split(","):
            option = option.strip()
            if option == "none":
                options.add(option)
            elif option not in ALL_OPTIONS:
                parser.error(
                    f"invalid option '{option}'; choose from: "
                    f"{', '.join(sorted(ALL_OPTIONS))}, none"
                )
            else:
                options.add(option)

    if "none" in options:
        if len(options) != 1:
            parser.error("option 'none' cannot be combined with other options")
        return set()
    if DISPLAY_OPTIONS <= options:
        parser.error("options 'popup' and 'split' cannot be combined")
    return options


def saved_options(state):
    options = state.get("options", [])
    if not isinstance(options, list):
        return set()
    return {option for option in options if option in MENU_OPTIONS}


def read_json(path):
    if not path or not os.path.exists(path):
        return {}
    try:
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
    except (json.JSONDecodeError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def loaded_state(path, key):
    data = read_json(path)
    saved_state = data.get(key, {})
    state = default_state()
    if not isinstance(saved_state, dict):
        return state

    for name in ("title", "prompt", "default", "backend", "layout"):
        if isinstance(saved_state.get(name), str):
            state[name] = saved_state[name]
    for name in ("index", "height"):
        if isinstance(saved_state.get(name), int) and not isinstance(saved_state[name], bool):
            state[name] = saved_state[name]
    if isinstance(saved_state.get("items"), list) and all(isinstance(item, str) for item in saved_state["items"]):
        state["items"] = saved_state["items"]
    if saved_state.get("delim") is None or isinstance(saved_state.get("delim"), str):
        state["delim"] = saved_state.get("delim")

    options = saved_options(saved_state)
    if saved_state.get("mru_enabled") is True:
        options.add("mru")
    state["options"] = sorted(options)

    if state["backend"] not in {"fzf", "legacy"}:
        state["backend"] = default_state()["backend"]
    if state["layout"] not in {"popup", "split", "plain"}:
        state["layout"] = default_state()["layout"]
    return state


def apply_arguments(state, args, command_options):
    for name in ("title", "prompt", "default", "index", "height", "backend", "delim"):
        value = getattr(args, name)
        if value is not None:
            state[name] = value
    if args.option is not None:
        if command_options & MENU_OPTIONS or not command_options:
            state["options"] = sorted(command_options & MENU_OPTIONS)
        if "split" in command_options:
            state["layout"] = "split"
        elif "popup" in command_options:
            state["layout"] = "popup"
        elif not command_options:
            state["layout"] = "plain"
    if args.backend == "fzf" and not (command_options & DISPLAY_OPTIONS):
        state["layout"] = "plain"
    state["options"] = sorted(saved_options(state))


def resolve_items(state, args):
    # Explicit arguments override piped input, which overrides saved items.
    if not sys.stdin.isatty():
        piped_items = [line.rstrip("\n") for line in sys.stdin if line.rstrip("\n")]
        if piped_items:
            state["items"] = piped_items

    if args.items:
        if len(args.items) == 1 and state["delim"] and state["delim"] in args.items[0]:
            state["items"] = args.items[0].split(state["delim"])
        else:
            state["items"] = args.items


def save_state(path, key, state):
    if not path:
        return
    data = read_json(path)
    data[key] = state
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=4, ensure_ascii=False)


def print_list(state):
    if state["title"]:
        print(f"--- {state['title']} ---")
    for index, item in enumerate(state["items"]):
        print(f"{index + state['index']}) {item}")


def select_with_fzf(state, options):
    menu_mode = "menu" in options
    if state["layout"] == "popup":
        command = ["fzf-tmux", "-p", "--"]
    elif state["layout"] == "split":
        command = ["fzf-tmux", "-d", "--"]
    else:
        command = ["fzf"]
    command += [f"--height={state['height']}", "--layout=reverse", f"--prompt={state['prompt']} "]
    if state["title"]:
        command += ["--header", state["title"]]
    if state["default"]:
        command += ["--query", state["default"]]
    if "multi" in options and menu_mode:
        command += ["--multi"]
    command += ["--with-nth=2.."]

    input_items = "\n".join(f"{index}\t{item}" for index, item in enumerate(state["items"]))
    command_env = os.environ.copy()
    item_file = None
    if not menu_mode:
        command += [
            "--style=minimal", "--min-height=3", "--info=hidden", "--no-multi",
            "--no-bold", "--color=current-bg:-1,current-fg:-1,hl:1:underline,hl+:1:underline",
            "--print-query", "--pointer=▌"
        ]
        command += ["--bind=start:transform:([[ -z \"$FZF_QUERY\" ]] && echo 'change-pointer(▌)' || echo 'change-pointer( )')"]
        command += ["--bind=change:transform:([[ -z \"$FZF_QUERY\" ]] && echo 'change-pointer(▌)' || echo 'change-pointer( )')"]
        command += ["--bind=down:transform:([[ \"$FZF_POINTER\" == \" \" ]] && echo 'first+change-pointer(▌)' || echo 'down+change-pointer(▌)')"]
        command += ["--bind=up:transform:([[ \"$FZF_POINTER\" == \" \" ]] && echo 'last+change-pointer(▌)' || echo 'up+change-pointer(▌)')"]
        command += ["--bind=page-down:page-down+change-pointer(▌)", "--bind=page-up:page-up+change-pointer(▌)"]
        command += ["--bind=shift-right:replace-query"]
        command += ["--bind=enter:transform:([[ \"$FZF_POINTER\" != \" \" ]] || grep -Fqx -- \"$FZF_QUERY\" \"$INPUT_ITEMS_FILE\") && echo accept || echo print-query"]
        item_file = tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", delete=False)
        item_file.write("\n".join(state["items"]))
        item_file.close()
        command_env["INPUT_ITEMS_FILE"] = item_file.name
        command_env["FZF_DEFAULT_OPTS"] = ""
    else:
        command += ["--bind=enter:accept"]

    try:
        try:
            process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env=command_env)
        except FileNotFoundError:
            return None
        stdout, _ = process.communicate(input=input_items)
    finally:
        if item_file is not None:
            os.unlink(item_file.name)
    if process.returncode != 0:
        return []

    lines = stdout.splitlines()
    if not menu_mode:
        query = lines[0] if lines else ""
        chosen = lines[1] if len(lines) > 1 else None
        if chosen is None:
            return [(None, query)]
        index, text = chosen.split("\t", 1)
        return [(int(index), text)]

    selections = []
    for line in lines:
        index, text = line.split("\t", 1)
        selections.append((int(index), text))
    return selections


def select_with_legacy(state, options):
    menu_mode = "menu" in options
    if state["title"]:
        print(f"== {state['title']} ==")
    for index, item in enumerate(state["items"]):
        print(f"{index + 1}) {item}")

    prompt = f"{state['prompt']} "
    if state["default"]:
        prompt = f"{prompt.strip()} (default: {state['default']}): "

    try:
        choice = input(prompt)
        if not menu_mode:
            if choice in state["items"]:
                index = state["items"].index(choice)
                return [(index, choice)]
            return [(None, choice)]
        if not choice and state["default"]:
            try:
                index = int(state["default"]) - 1
                return [(index, state["items"][index])]
            except (ValueError, IndexError):
                index = state["items"].index(state["default"]) if state["default"] in state["items"] else 0
                return [(index, state["default"])]

        choices = choice.split(",") if "multi" in options else [choice]
        selections = []
        for choice in choices:
            index = int(choice.strip()) - 1
            selection = (index, state["items"][index])
            if selection not in selections:
                selections.append(selection)
        return selections
    except (ValueError, IndexError, EOFError, KeyboardInterrupt):
        return []


def select_items(state, options):
    if state["backend"] == "fzf":
        selections = select_with_fzf(state, options)
        if selections is not None:
            return selections
    return select_with_legacy(state, options)


def print_selections(selections, state, options):
    for index, text in selections:
        if index is None:
            print(text)
        elif "value" in options:
            print(index + state["index"])
        elif state["delim"] and state["delim"] in text:
            print(text.split(state["delim"])[0])
        else:
            print(text)


def update_mru(state, selections):
    selected_items = [text for _, text in selections if text is not None]
    state["items"] = selected_items + [item for item in state["items"] if item not in selected_items]


def main():
    parser = argparse.ArgumentParser(description="Python input picker with input and menu modes.")
    parser.add_argument("-t", "--title", help="Set picker title (header)")
    parser.add_argument("-p", "--prompt", help="Set prompt string")
    parser.add_argument("-d", "--default", help="Initial query or default index")
    parser.add_argument("-i", "--index", type=int, help="Starting index for menu value output")
    parser.add_argument(
        "-o", "--option", action="append", metavar="OPTION[,OPTION...]",
        help="Modes: list, menu, mru, multi, value; file: load, save; display: popup, split; none clears modes and uses plain fzf"
    )
    parser.add_argument("-D", "--delim", help="Delimiter for input splitting or result parsing")
    parser.add_argument("-f", "--file", help="JSON state file (load and save by default)")
    parser.add_argument("-k", "--key", default="__global__", help="Specific key in JSON (default: __global__)")
    parser.add_argument("-b", "--backend", choices=["fzf", "legacy"], help="Picker backend")
    parser.add_argument("-H", "--height", type=int, help="fzf list height (integer)")
    parser.add_argument("items", nargs="*", help="Reference items (passed as arguments)")

    args = parser.parse_args()
    command_options = selected_options(parser, args.option)
    file_options = command_options & FILE_OPTIONS
    load = bool(args.file) and (not file_options or "load" in file_options)
    save = bool(args.file) and (not file_options or "save" in file_options)
    state = loaded_state(args.file if load else None, args.key)
    apply_arguments(state, args, command_options)
    resolve_items(state, args)

    if not state["items"] and "menu" in state["options"]:
        if save:
            save_state(args.file, args.key, state)
        return 0

    options = set(state["options"])
    if "list" in options:
        print_list(state)
        if save:
            save_state(args.file, args.key, state)
        return 0

    selections = select_items(state, options)
    if not selections:
        return 1

    print_selections(selections, state, options)
    if "mru" in options:
        update_mru(state, selections)
    if save:
        save_state(args.file, args.key, state)
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys


MENU_OPTIONS = {"list", "mru", "multi", "value"}


def default_state():
    return {
        "title": "",
        "prompt": ">",
        "default": "",
        "index": 0,
        "items": [],
        "height": 10,
        "backend": "fzf",
        "delim": None,
        "options": []
    }


def selected_options(parser, option_groups):
    options = set()
    for option_group in option_groups or []:
        for option in option_group.split(","):
            option = option.strip()
            if option == "none":
                options.add(option)
            elif option not in MENU_OPTIONS:
                parser.error(
                    f"invalid option '{option}'; choose from: "
                    f"{', '.join(sorted(MENU_OPTIONS))}, none"
                )
            else:
                options.add(option)

    if "none" in options:
        if len(options) != 1:
            parser.error("option 'none' cannot be combined with other options")
        return set()
    return options


def saved_options(state):
    options = state.get("options", [])
    if not isinstance(options, list):
        return set()
    return {option for option in options if option in MENU_OPTIONS}


def read_json(path):
    if not path or not os.path.exists(path):
        return {}
    try:
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
    except (json.JSONDecodeError, OSError):
        return {}
    return data if isinstance(data, dict) else {}


def loaded_state(path, key):
    data = read_json(path)
    saved_state = data.get(key, {})
    state = default_state()
    if not isinstance(saved_state, dict):
        return state

    for name in ("title", "prompt", "default", "backend"):
        if isinstance(saved_state.get(name), str):
            state[name] = saved_state[name]
    for name in ("index", "height"):
        if isinstance(saved_state.get(name), int) and not isinstance(saved_state[name], bool):
            state[name] = saved_state[name]
    if isinstance(saved_state.get("items"), list) and all(isinstance(item, str) for item in saved_state["items"]):
        state["items"] = saved_state["items"]
    if saved_state.get("delim") is None or isinstance(saved_state.get("delim"), str):
        state["delim"] = saved_state.get("delim")

    options = saved_options(saved_state)
    if saved_state.get("mru_enabled") is True:
        options.add("mru")
    state["options"] = sorted(options)

    if state["backend"] not in {"fzf", "fzf-tmux", "legacy"}:
        state["backend"] = default_state()["backend"]
    return state


def apply_arguments(state, args, command_options):
    for name in ("title", "prompt", "default", "index", "height", "backend", "delim"):
        value = getattr(args, name)
        if value is not None:
            state[name] = value
    if args.option is not None:
        state["options"] = sorted(command_options)
    state["options"] = sorted(saved_options(state))


def resolve_items(state, args):
    # Explicit arguments override piped input, which overrides saved items.
    if not sys.stdin.isatty():
        piped_items = [line.strip() for line in sys.stdin if line.strip()]
        if piped_items:
            state["items"] = piped_items

    if args.items:
        if len(args.items) == 1 and state["delim"] and state["delim"] in args.items[0]:
            state["items"] = args.items[0].split(state["delim"])
        else:
            state["items"] = args.items


def save_state(path, key, state):
    if not path:
        return
    data = read_json(path)
    data[key] = state
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=4, ensure_ascii=False)


def print_list(state):
    if state["title"]:
        print(f"--- {state['title']} ---")
    for index, item in enumerate(state["items"]):
        print(f"{index + state['index']}) {item}")


def select_with_fzf(state, options):
    command = ["fzf"] if state["backend"] == "fzf" else ["fzf-tmux", "-p"]
    command += [f"--height={state['height']}", "--layout=reverse", f"--prompt={state['prompt']} "]
    if state["title"]:
        command += ["--header", state["title"]]
    if state["default"]:
        command += ["--query", state["default"]]
    if "multi" in options:
        command += ["--multi"]
    command += ["--with-nth=2.."]

    input_data = "\n".join(f"{index}\t{item}" for index, item in enumerate(state["items"]))
    try:
        process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    except FileNotFoundError:
        return None

    stdout, _ = process.communicate(input=input_data)
    selections = []
    for line in stdout.splitlines():
        index, text = line.split('\t', 1)
        selections.append((int(index), text))
    return selections


def select_with_legacy(state, options):
    if state["title"]:
        print(f"== {state['title']} ==")
    for index, item in enumerate(state["items"]):
        print(f"{index + 1}) {item}")

    prompt = f"{state['prompt']} "
    if state["default"]:
        prompt = f"{prompt.strip()} (default: {state['default']}): "

    try:
        choice = input(prompt)
        if not choice and state["default"]:
            try:
                index = int(state["default"]) - 1
                return [(index, state["items"][index])]
            except (ValueError, IndexError):
                index = state["items"].index(state["default"]) if state["default"] in state["items"] else 0
                return [(index, state["default"])]

        choices = choice.split(",") if "multi" in options else [choice]
        selections = []
        for choice in choices:
            index = int(choice.strip()) - 1
            selection = (index, state["items"][index])
            if selection not in selections:
                selections.append(selection)
        return selections
    except (ValueError, IndexError, EOFError, KeyboardInterrupt):
        return []


def select_items(state, options):
    if state["backend"] in {"fzf", "fzf-tmux"}:
        selections = select_with_fzf(state, options)
        if selections is not None:
            return selections
    return select_with_legacy(state, options)


def print_selections(selections, state, options):
    for index, text in selections:
        if "value" in options:
            print(index + state["index"])
        elif state["delim"] and state["delim"] in text:
            print(text.split(state["delim"])[0])
        else:
            print(text)


def update_mru(state, selections):
    selected_items = [text for _, text in selections]
    state["items"] = selected_items + [item for item in state["items"] if item not in selected_items]


def main():
    parser = argparse.ArgumentParser(description="Python-based fzf menu with JSON state.")
    parser.add_argument("-t", "--title", help="Set menu title (header)")
    parser.add_argument("-p", "--prompt", help="Set prompt string")
    parser.add_argument("-d", "--default", help="Initial query or default index")
    parser.add_argument("-I", "--index", type=int, help="Starting index for --option value output")
    parser.add_argument(
        "-o", "--option", action="append", metavar="OPTION[,OPTION...]",
        help="Select modes: list, mru, multi, value; use none to clear saved modes"
    )
    parser.add_argument("-D", "--delim", help="Delimiter for input splitting or result parsing")
    parser.add_argument("-s", "--save", help="Save state to a JSON file")
    parser.add_argument("-l", "--load", help="Load state from a JSON file")
    parser.add_argument("-k", "--key", default="__global__", help="Specific key in JSON (default: __global__)")
    parser.add_argument("-b", "--backend", choices=["fzf", "fzf-tmux", "legacy"], help="Menu backend")
    parser.add_argument("-H", "--height", type=int, help="fzf list height (integer)")
    parser.add_argument("items", nargs="*", help="Menu items (passed as arguments)")

    args = parser.parse_args()
    command_options = selected_options(parser, args.option)
    state = loaded_state(args.load, args.key)
    apply_arguments(state, args, command_options)
    resolve_items(state, args)

    if not state["items"]:
        save_state(args.save, args.key, state)
        return 0

    options = set(state["options"])
    if "list" in options:
        print_list(state)
        save_state(args.save, args.key, state)
        return 0

    selections = select_items(state, options)
    if not selections:
        return 1

    print_selections(selections, state, options)
    if "mru" in options:
        update_mru(state, selections)
    save_state(args.save, args.key, state)
    return 0


if __name__ == "__main__":
    sys.exit(main())

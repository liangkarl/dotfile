#!/usr/bin/env python3
import sys
import os
import json
import subprocess
import argparse


MENU_OPTIONS = {"list", "mru", "multi", "value"}


def selected_options(parser, option_groups):
    options = set()
    for option_group in option_groups or []:
        for option in option_group.split(","):
            option = option.strip()
            if option not in MENU_OPTIONS:
                parser.error(
                    f"invalid option '{option}'; choose from: "
                    f"{', '.join(sorted(MENU_OPTIONS))}"
                )
            options.add(option)
    return options


def main():
    parser = argparse.ArgumentParser(description="Python-based fzf menu with JSON state.")
    parser.add_argument("-t", "--title", help="Set menu title (header)")
    parser.add_argument("-p", "--prompt", help="Set prompt string")
    parser.add_argument("-d", "--default", help="Initial query or default index")
    parser.add_argument("-I", "--index", type=int, help="Starting index for --option value output")
    parser.add_argument(
        "-o", "--option", action="append", metavar="OPTION[,OPTION...]",
        help="Select modes: list, mru, multi, value (comma-separated or repeatable)"
    )
    parser.add_argument("-D", "--delim", help="Delimiter for input splitting or result parsing")
    parser.add_argument("-s", "--save", help="Save state to a JSON file")
    parser.add_argument("-l", "--load", help="Load state from a JSON file")
    parser.add_argument("-k", "--key", default="__global__", help="Specific key in JSON (default: __global__)")
    parser.add_argument("-b", "--backend", choices=["fzf", "fzf-tmux", "legacy"], help="Menu backend")
    parser.add_argument("-H", "--height", type=int, help="fzf list height (integer)")
    parser.add_argument("items", nargs="*", help="Menu items (passed as arguments)")

    args = parser.parse_args()
    options = selected_options(parser, args.option)

    # 1. Initialize default state structure
    state = {
        "title": "",
        "prompt": ">",
        "default": "",
        "index": 0,
        "items": [],
        "height": 10, # Default as integer
        "backend": "fzf",
        "mru_enabled": False
    }

    runtime_delim = args.delim
    full_data = {}
    target_key = args.key

    # 2. Load state from JSON file
    load_path = args.load
    if load_path and os.path.exists(load_path):
        try:
            with open(load_path, 'r', encoding='utf-8') as f:
                full_data = json.load(f)

            # Access the specific key (or __global__)
            if target_key in full_data and isinstance(full_data[target_key], dict):
                state.update(full_data[target_key])
        except (json.JSONDecodeError, IOError):
            pass

    # 3. Override state with command line arguments (if provided)
    if args.title: state["title"] = args.title
    if args.prompt: state["prompt"] = args.prompt
    if args.default: state["default"] = args.default
    if args.index is not None: state["index"] = args.index
    if args.height is not None: state["height"] = args.height
    if args.backend: state["backend"] = args.backend
    if "mru" in options: state["mru_enabled"] = True

    # 4. Input Handling (Pipe > Arguments > JSON)
    if not sys.stdin.isatty():
        # Read from pipe if data is being streamed in
        piped_data = [line.strip() for line in sys.stdin if line.strip()]
        if piped_data:
            state["items"] = piped_data

    if args.items:
        # If a single argument is passed containing the delimiter, split it into multiple items
        if len(args.items) == 1 and runtime_delim and runtime_delim in args.items[0]:
            state["items"] = args.items[0].split(runtime_delim)
        else:
            state["items"] = args.items

    # Exit if there is nothing to display
    if not state["items"]:
        sys.exit(0)

    # 5. List mode (CLI listing only)
    if "list" in options:
        if state["title"]: print(f"--- {state['title']} ---")
        for i, item in enumerate(state["items"]):
            print(f"{i + state['index']}) {item}")
        sys.exit(0)

    # 6. Interactive Selection via fzf
    full_prompt = f"{state['prompt']} "
    selections = []

    if state["backend"] in ["fzf", "fzf-tmux"]:
        try:
            cmd = ["fzf"] if state["backend"] == "fzf" else ["fzf-tmux", "-p"]
            fzf_cmd = cmd + [f"--height={state['height']}", "--layout=reverse", f"--prompt={full_prompt}"]
            if state["title"]: fzf_cmd += ["--header", state["title"]]
            if state["default"]: fzf_cmd += ["--query", state["default"]]
            if "multi" in options: fzf_cmd += ["--multi"]

            input_data = "\n".join(f"{i}\t{item}" for i, item in enumerate(state["items"]))
            fzf_cmd += ["--with-nth=2.."]

            proc = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
            stdout, _ = proc.communicate(input=input_data)

            for line in stdout.splitlines():
                idx_part, selected_text = line.split('\t', 1)
                selections.append((int(idx_part), selected_text))

            if not selections: sys.exit(1)
        except FileNotFoundError:
            state["backend"] = "legacy"

    if state["backend"] == "legacy":
        if state["title"]: print(f"== {state['title']} ==")
        for i, item in enumerate(state["items"]):
            print(f"{i + 1}) {item}")

        legacy_prompt = full_prompt
        if state["default"]:
            legacy_prompt = f"{full_prompt.strip()} (default: {state['default']}): "

        try:
            choice = input(legacy_prompt)
            if not choice and state["default"]:
                try:
                    selected_idx = int(state["default"]) - 1
                    selected_text = state["items"][selected_idx]
                except (ValueError, IndexError):
                    selected_text = state["default"]
                    selected_idx = state["items"].index(selected_text) if selected_text in state["items"] else 0
                selections.append((selected_idx, selected_text))
            else:
                choices = [choice]
                if "multi" in options:
                    choices = [item.strip() for item in choice.split(',')]

                for choice in choices:
                    selected_idx = int(choice) - 1
                    selected_text = state["items"][selected_idx]
                    if (selected_idx, selected_text) not in selections:
                        selections.append((selected_idx, selected_text))

            if not selections:
                sys.exit(1)
        except (ValueError, IndexError, EOFError, KeyboardInterrupt):
            sys.exit(1)

    # 7. Final Output
    for selected_idx, selected_text in selections:
        if "value" in options:
            # Return index (adjusted by offset)
            print(selected_idx + state["index"])
        elif runtime_delim and runtime_delim in selected_text:
            # If delimiter is set and present in text, return the first field (Key/ID)
            print(selected_text.split(runtime_delim)[0])
        else:
            print(selected_text)

    # 8. Update MRU order (only if enabled)
    if state["mru_enabled"]:
        selected_texts = [selected_text for _, selected_text in selections]
        state["items"] = selected_texts + [item for item in state["items"] if item not in selected_texts]

    # 9. Persistent State Saving
    save_path = args.save or args.load
    if save_path:
        # Always save into the specified key (defaults to __global__)
        full_data[target_key] = state

        with open(save_path, 'w', encoding='utf-8') as f:
            json.dump(full_data, f, indent=4, ensure_ascii=False)

if __name__ == "__main__":
    main()

[color]
	ui = auto
[core]
	editor = vim
[rerere]
	enabled = true
[fetch]
	prune = true
[difftool]
	prompt = true
[difftool "vim"]
	cmd = vim -d \"$LOCAL\" \"$REMOTE\"
[diff]
	tool = vim
	algorithm = patience
[commit]
	verbose = true
[merge]
	tool = vim
[mergetool]
	prompt = true
[mergetool "vim"]
	cmd = vim -d \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\" -c 'wincmd J | wincmd ='
[push]
	default = simple
[pretty]
	slog = format:%C(yellow)%h %Cred%as %Cblue%an%Cgreen%d %Creset%s
	bw = format:%h | %as | %>(20,trunc)%d%x09%s
[alias]
	type = cat-file -t
	dump = cat-file -p
	diffname = diff --name-only
	diffnp = !git --no-pager diff
	last = show -s HEAD^{commit}
	stat = diff --stat-width=65
	new = !git fetch -a -p && git status
	dr = diff --relative
	ds = diff --staged
	slog = log --pretty=slog
	slogbw = log --pretty=bw
	# show cached diff or add unstaged files
	cache = "!f() { if [ $# -eq 0 ]; then git diff --cached; else git add \"$@\"; fi; }; f"
	# edit gitignore or add ignore rule
	ignore = "!f() { f=".gitignore"; r=$(git rev-parse --show-toplevel); [ $# -eq 0 ] && ${EDITOR:-vi} $r/$f || echo "$@" >> $r/$f; }; f"
	# diff of last commit
	dlc = diff --cached HEAD^
	# list all defined aliases
	alias = config --get-regexp ^alias\\.
	# what would be merged
	incoming = log HEAD..@{upstream}
	# what would be pushed
	outgoing = log --pretty=slog @{upstream}..HEAD
	# inline diff
	wdiff = diff -w --word-diff=color --ignore-space-at-eol

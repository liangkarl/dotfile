#!/usr/bin/env python3

import os
import sys
import subprocess
import argparse
import json
import re

cmd = subprocess

def run(argv):
    return cmd.run(argv, stdout=True, stderr=True, text=True)

def shell(argv):
    return cmd.run(argv, stdout=True, stderr=True)

def parse_args(argv):
    parser = argparse.ArgumentParser(description='tmux entries')
    parser.add_argument('-l', '--list', action='store_true',
                        help='list the sessions')
    parser.add_argument('-r', '--rename', action='store_true',
                        help='rename a session')
    parser.add_argument('-c', '--create', action='store_true',
                        help='create a session')
    parser.add_argument('-s', '--save', action='store_true',
                        help='save the session')
    parser.add_argument('-d', '--delete', action='store_true',
                        help='delete a session')
    parser.add_argument('-e', '--edit', action='store_true',
                        help='edit a session')
    parser.add_argument('-E', '--enter', action='store_true',
                        default=True, help='enter a session')
    return parser.parse_args(argv)

def get_entry(config_dir):
    r = cmd.run(f'ls {config_dir} | cut -d. -f1 | fzf',
                shell=True, capture_output=True, text=True)
    return r.stdout.strip() or None

def get_entry_name(str):
    entry = input(f"{str}: ")
    if not entry:
        print("No name given")
        exit(1)
    elif entry.find('.') >= 0:
        print("Invalid name due to '.'")
        exit(2)

    return entry

def rename_session(config_path, session_name):
    """Update the top-level tmuxp session_name without renaming its file."""
    with open(config_path, encoding='utf-8') as config_file:
        config = config_file.read()

    # JSON strings are valid YAML scalars, and quote names containing YAML
    # metacharacters so the resulting configuration remains valid.
    replacement = f'session_name: {json.dumps(session_name)}'
    updated_config, replacements = re.subn(
        r'^session_name:[^\n]*(?=\n|$)',
        lambda _: replacement,
        config,
        count=1,
        flags=re.MULTILINE,
    )
    if replacements != 1:
        raise ValueError(f"No top-level session_name found in {config_path}")

    with open(config_path, 'w', encoding='utf-8') as config_file:
        config_file.write(updated_config)

def main(argv):
    config_dir = os.environ["XDG_CONFIG_HOME"] + '/tmuxp'
    args = parse_args(argv)

    if args.list:
        run(['tmuxp', 'ls'])
        exit(0)

    if args.create:
        print("NOTE: The default configuration of new entry "
              "will be the current tmux session")
        entry = get_entry_name("Name the new entry")
        args.save = True

        opt = input("Do you want to edit it now? [y/N] ")
        if opt == 'y':
            args.edit = True

    else:
        entry = get_entry(config_dir)
        if entry is None:
            print("No entry selected")
            exit(1)

    if args.save:
        if args.create:
            shell(['tmuxp', 'freeze', '-o', f'{config_dir}/{entry}.yaml'])
        else:
            shell(['tmuxp', 'freeze', '-o', f'{config_dir}/{entry}.yaml', entry])
        print(f"Saved {entry}")

    if args.edit:
        shell(['tmuxp', 'edit', entry])

    if args.rename:
        name = get_entry_name("Rename to a new entry")
        try:
            rename_session(f'{config_dir}/{entry}.yaml', name)
            run(['mv', f'{config_dir}/{entry}.yaml', f'{config_dir}/{name}.yaml'])
        except (OSError, ValueError) as error:
            print(f"Failed to rename session: {error}", file=sys.stderr)
            exit(1)
        print(f"Renamed session to {name}")
        exit(0)

    if args.delete:
        run(['rm', f'{config_dir}/{entry}.yaml'])
        print(f"Deleted {entry}")
        exit(0)

    if args.enter:
        shell(["tmuxp", "load", entry])

    exit(0)

if __name__ == '__main__':
    main(sys.argv[1:])

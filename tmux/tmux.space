#!/usr/bin/env bash
# NAME:
# $0
#
# DESCRIPTION:
# $0 is used for attaching specific tmux entry, configed by ts.conf
#
# SYNOPSIS:
# $0 [OPTIONS]
#
# OPTIONS:
#   '': enter entry
#   -c: create new entry
#   -r: rename entry
#   -d: delete entrys
#   -e: edit entry configuration
#   -s: save current tmux session to workspace
#   -h: help
#
# SAMPLE:
#  $ tmux -s test           # create a active session
#  $ tmux.space -s test     # save the session

# this is for setting up a workspace in tmux
# TARGET_DIR=$(fasd -d $@)
TARGET_NAME="$1"

lib.load menu
lib.load devel
# dbg.on

get_entry() {
	menu.title "$*"
	# tmuxp lis only list workspaces in .config/tmuxp, and doesn't
	# check availability
	menu.opts $(tmuxp ls)
	menu.run

	msg.dbg "idx: $(menu.ans_idx)"
	msg.dbg "opt: $(menu.ans_opt)"

	[[ $(menu.ans_idx) -ge 0 ]]
}

cmd.has tmuxp || msg.exit 1  "no 'tmuxp' command available."

# set -xv
set -eE

CONFDIR="$XDG_CONFIG_HOME/tmuxp"

set -- $(getopt ":sdehrc" $*)

while [[ $# -ne 0 ]]; do
	case $1 in
		-d) remove=y;;
		-e) edit=y;;
		-h) cmd.help 0;;
		-s) save=y;;
		-r) rename=y;;
		-c) create=y;;
		--) enter=y;;
		*) cmd.help 1;;
	esac
	shift
done

if [[ "$create" == y ]]; then
	echo "NOTE: The default configuration of new entry will be the current tmux session"
	read -p "create new workspace name: " name
	if [[ -z "$name" ]]; then
		msg.exit 1 "no name given"
	fi

	tmuxp freeze -o ${CONFDIR}/${name}.yaml || msg.exit $? "Exit"

	read -p "edit $name(y/N): " opt
	if [[ "$opt" == y ]]; then
		tmuxp edit $name
	fi
	exit
fi

if ! get_entry "select a profile:"; then
	msg.exit 1 "no configuration selected"
fi

entry="$(menu.ans_opt)"
if [[ -z "$entry" ]]; then
	msg.exit 1 "no available entry"
fi

if [[ "$rename" == y ]]; then
	read -p "new workspace name: " name
	if [[ -z "$name" ]]; then
		msg.exit 1 "no name given"
	fi
	mv ${CONFDIR}/${entry} ${CONFDIR}/${name}
fi

if [[ "$save" == y ]]; then
	tmuxp freeze -o ${CONFDIR}/${entry}.yaml $entry
fi

if [[ "$edit" == y ]]; then
	tmuxp edit $entry
fi

if [[ "$remove" == y ]]; then
	rm ${CONFDIR}/${entry}.yaml
	exit
fi

if [[ "$enter" == y ]]; then
	tmuxp load $entry
fi
